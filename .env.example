# データベース接続先の URL。
# sqlite:// の後はプロジェクトルートからの相対パス。
# data/ ディレクトリと app.db ファイルは起動時に自動生成される（create_if_missing = true）。
DATABASE_URL=sqlite://data/app.db

# サーバーのリッスンポート番号。
# 未設定または不正値の場合は 3000 を使う。
PORT=3000

# 画像アップロード先のディレクトリ（プロジェクトルートからの相対パス）。
# 画像は {投稿ID}.{拡張子} の名前で保存される。ディレクトリは起動時に自動で作成される。
UPLOAD_DIR=uploads

# ログの詳しさ（tracing の EnvFilter の書式）。未設定なら info。
# 例: RUST_LOG=debug / RUST_LOG=info,rust_axum_image_bbs=debug
RUST_LOG=info

# ログの形式。json にすると1行1つの JSON で出る。未設定なら人間向けのテキスト。
# LOG_FORMAT=json

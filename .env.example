# データベース接続先の URL。
# sqlite:// の後はプロジェクトルートからの相対パス。
# data/ ディレクトリと app.db ファイルは起動時に自動生成される（create_if_missing = true）。
DATABASE_URL=sqlite://data/app.db

# サーバーのリッスンポート番号。
# 現状はコード内で 3000 固定だが、将来的に環境変数から読む実装に切り替える際のひな形。
PORT=3000

# 画像アップロード先のディレクトリ（プロジェクトルートからの相対パス）。
# アップロード機能は TASK-0005 以降で実装予定。
UPLOAD_DIR=uploads
